<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8" />
<title>{{ held.meta.name }} — Heldenkodex</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cardo:ital,wght@0,400;0,700;1,400&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
{{ css_bundle() }}</style>
</head>
<body>
{#- ── Macro: render probe abbreviations with inline eigenschaft values ── -#}
{%- macro probe_eig(probe, eig) -%}
  {%- if '/' in (probe or '') -%}
    {%- for abbr in probe.split('/') -%}
      {%- set a = abbr | trim -%}
      {%- if not loop.first %} / {% endif -%}
      {%- if a == '**' %}**{%- elif eig.get(a) %}<span class="pv" data-attr="{{ a | e }}" data-base="{{ eig[a].aktuell | e }}">{{ a }} {{ eig[a].aktuell }}</span>{%- else %}{{ a }}{%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {{ probe | e }}
  {%- endif -%}
{%- endmacro -%}
{#- ── Macro: compact Eigenschaften+Basiswerte bar, sticky atop Talente/Zauber tabs (D-025) ── -#}
{%- macro eig_leiste(eig, basis) -%}
<div class="eig-leiste">
  <span class="eig-leiste-grp">
    {%- for a in ['MU','KL','IN','CH','FF','GE','KO','KK'] -%}
    {%- if not loop.first %}<span class="eig-leiste-sep">·</span>{% endif -%}
    <span class="eig-leiste-abbr">{{ a }}</span> <span class="eig-leiste-v">{{ eig.get(a, {}).get('aktuell', '?') | e }}</span>
    {%- endfor -%}
  </span>
  <span class="eig-leiste-div"></span>
  <span class="eig-leiste-grp">
    <span class="eig-leiste-abbr">LE</span> <span class="eig-leiste-v">{{ basis.get('LE', {}).get('current', '?') | e }}</span>
    <span class="eig-leiste-sep">·</span>
    <span class="eig-leiste-abbr">AE</span> <span class="eig-leiste-v">{{ basis.get('AE', {}).get('current', '?') | e }}</span>
    <span class="eig-leiste-sep">·</span>
    <span class="eig-leiste-abbr">MR</span> <span class="eig-leiste-v">{{ basis.get('MR', {}).get('aktuell', '?') | e }}</span>
  </span>
  <span class="eig-leiste-mods"></span>
</div>
{%- endmacro -%}
<div class="codex">
<nav class="tab-bar" role="tablist" aria-label="Dashboard-Bereiche">
  <button class="tab-btn" data-tab="kampf"    type="button">⚔️ Kampf</button>
  <button class="tab-btn" data-tab="talente"  type="button">🎯 Talente</button>
  <button class="tab-btn" data-tab="zauber"   type="button">✨ Zauber</button>
  <button class="tab-btn" data-tab="steigern" type="button">⭐ Steigern</button>
  <button class="tab-btn" data-tab="inventar" type="button">🎒 Inventar</button>
  <button class="tab-btn" data-tab="profil"   type="button">📋 Profil</button>
  <button class="tab-btn" data-tab="chronik"  type="button">📜 Chronik</button>
  <button class="tab-btn" data-tab="sprachen" type="button">🗣️ Sprachen</button>
</nav>

{% set name_parts = held.meta.name.split(' ') %}
{% set first_name = name_parts[:-1] | join(' ') %}
{% set last_name = name_parts[-1] %}

<!-- ============================================================
     IDENTITY BANNER (Seite 1 im Print)
     ============================================================ -->
<header class="banner">
  <div class="sparkles screen-only">
    <span class="sparkle"></span><span class="sparkle big"></span><span class="sparkle"></span>
    <span class="sparkle"></span><span class="sparkle"></span><span class="sparkle big"></span>
    <span class="sparkle"></span><span class="sparkle"></span><span class="sparkle"></span>
    <span class="sparkle big"></span><span class="sparkle"></span><span class="sparkle"></span>
  </div>

  <div class="banner-inner">
    <div class="crest">
      <svg viewBox="0 0 100 100" fill="none" stroke="#5fc3e4" stroke-width="1.2">
        <polygon points="50,4 92,28 92,72 50,96 8,72 8,28" />
        <polygon points="50,12 84,32 84,68 50,88 16,68 16,32" stroke-opacity=".5" />
        <line x1="50" y1="22" x2="50" y2="78" stroke-width="2"/>
        <circle cx="50" cy="50" r="9" stroke="#d4a84b" />
        <circle cx="50" cy="50" r="3" fill="#d4a84b" stroke="none"/>
        <line x1="50" y1="50" x2="30" y2="30" />
        <line x1="50" y1="50" x2="70" y2="30" />
        <line x1="50" y1="50" x2="30" y2="70" />
        <line x1="50" y1="50" x2="70" y2="70" />
        <line x1="50" y1="50" x2="50" y2="32" stroke="#e8dcc3" stroke-opacity=".6"/>
        <line x1="50" y1="50" x2="50" y2="68" stroke="#e8dcc3" stroke-opacity=".6"/>
      </svg>
    </div>

    <div class="title-block">
      <p class="eyebrow">{% if held.meta.kolleg %}{{ held.meta.kolleg }}{% else %}{{ held.meta.tradition }}{% endif %} · {{ held.meta.tradition }}</p>
      <h1>{{ first_name }} <span class="strand">{{ last_name }}</span></h1>
      {% if held.meta.wahrer_name %}<div class="subline">„{{ held.meta.wahrer_name }}" — {{ held.meta.wahrer_name_bedeutung }}</div>{% endif %}
    </div>

    <div class="identity-stats">
      <div class="istat">
        <span class="num">{{ held.meta.stufe | roman }}</span>
        <span class="lbl">Stufe</span>
      </div>
      <div class="istat">
        <span class="num">{{ held.meta.ap_gesamt | format_ap }}</span>
        <span class="lbl">AP gesamt</span>
      </div>
      <div class="istat">
        <span class="num cold">{{ held.meta.ap_verfuegbar }}</span>
        <span class="lbl">AP frei</span>
      </div>
    </div>
  </div>

  <div class="banner-meta">
    <span><strong>{{ held.meta.rasse }}</strong></span><span class="sep">·</span>
    <span><strong>{{ held.meta.kultur }}</strong></span><span class="sep">·</span>
    <span><strong>{{ held.meta.profession_short }}</strong></span><span class="sep">·</span>
    <span>Tradition <strong>{{ held.meta.tradition }}</strong></span>
    {% if held.meta.stigma %}<span class="sep">·</span><span>Stigma <strong>{{ held.meta.stigma }}</strong></span>{% endif %}
  </div>
</header>

{% set le = held.basiswerte.get('LE', {}) %}
{% set ae = held.basiswerte.get('AE', {}) %}
{% set au = held.basiswerte.get('AU', {}) %}
{% include 'partials/kampf.j2' %}
{% include 'partials/talente.j2' %}
{% include 'partials/zauber.j2' %}

{% include 'partials/steigern.j2' %}

{% include 'partials/inventar.j2' %}

{% include 'partials/profil.j2' %}

{% include 'partials/chronik.j2' %}

{% include 'partials/sprachen.j2' %}

</div><!-- .codex -->

<div id="footer-bar" class="screen-only">
  <button class="print-btn" onclick="window.print()">Kodex drucken</button>
  <button id="session-reset-btn" class="print-btn">Session zurücksetzen</button>
  <div id="save-group">
    <input id="commit-msg" type="text" class="commit-input" placeholder="Commit-Nachricht (optional)">
    <button id="commit-btn" class="print-btn">💾 Sichern</button>
  </div>
</div>

<script>
/* Sortierung Zauber-Tabelle: Click auf ZfW-Header */
(function(){
  var spells = document.querySelectorAll('.spell:not(:first-child)');
  var container = spells[0] && spells[0].parentNode;
  var header = document.querySelector('.spell:first-child');
  if (!container || !header) return;
  var asc = false;
  header.style.cursor = 'pointer';
  header.title = 'Nach ZfW sortieren';
  header.addEventListener('click', function(){
    asc = !asc;
    var arr = Array.from(spells);
    arr.sort(function(a, b){
      var za = parseInt(a.querySelector('.zfw-num') && a.querySelector('.zfw-num').textContent) || 0;
      var zb = parseInt(b.querySelector('.zfw-num') && b.querySelector('.zfw-num').textContent) || 0;
      return asc ? za - zb : zb - za;
    });
    arr.forEach(function(el){ container.appendChild(el); });
  });
})();
</script>
<div id="dice-panel" class="dice-panel hidden">
  <div class="dice-panel-header">
    <span id="dp-title">🎲 Probe</span>
    <span class="dp-mode-btns">
      <button id="dp-auto" class="dp-btn active" type="button">Auto</button>
      <button id="dp-manual" class="dp-btn" type="button">Manuell</button>
    </span>
    <button id="dp-close" class="dp-btn" type="button" aria-label="Panel schließen">✕</button>
  </div>
  <div id="dp-eig-row" class="dp-eig-row"></div>
  <div id="dp-dice-row" class="dp-dice-row"></div>
  <div id="dp-result" class="dp-result"></div>
  <div class="dp-controls">
    <label>Erschwernis&thinsp;<input id="dp-mod" type="number" value="0" min="-20" max="20"></label>
    <button id="dp-roll" class="dp-btn primary" type="button">🔁 Neu würfeln</button>
  </div>
  <div id="dp-action" class="dp-action"></div>
</div>
<div id="save-indicator"></div>
<script>
/* DSA character data for dice.js — regenerated on each render */
window.DSA = {
  eig: {
    MU: {{ held.eigenschaften.MU.aktuell }},
    KL: {{ held.eigenschaften.KL.aktuell }},
    IN: {{ held.eigenschaften.IN.aktuell }},
    CH: {{ held.eigenschaften.CH.aktuell }},
    FF: {{ held.eigenschaften.FF.aktuell }},
    GE: {{ held.eigenschaften.GE.aktuell }},
    KO: {{ held.eigenschaften.KO.aktuell }},
    KK: {{ held.eigenschaften.KK.aktuell }}
  },
  vitals: {
    LE: { current: {{ le.current }}, max: {{ le.max }} },
    AE: { current: {{ ae.current }}, max: {{ ae.max }} },
    AU: { current: {{ au.current }}, max: {{ au.max }} }
  },
  steigern: {
    talente: {{ held.steigerbar_talente | tojson }},
    zauber:  {{ held.steigerbar_zauber  | tojson }},
    ap: {
      verfuegbar:   {{ held.meta.ap_verfuegbar }},
      eingesetzt:   {{ held.meta.ap_eingesetzt }},
      gesamt:       {{ held.meta.ap_gesamt }},
      stufe:        {{ held.meta.stufe }},
      bis_naechste: {{ held.get('_ap_bis_naechste_stufe') | tojson }}
    }
  },
  slug: "{{ slug }}",
  inventar: {
    geld: {{ held.ausruestung.geld | tojson }},
    items: {{ held.ausruestung.inventar | tojson }},
    inventar_gewicht_unzen: {{ held.ausruestung.inventar_gewicht_unzen }}
  },
  zauberspeicher: {{ held.rituale.zauberspeicher_slots | tojson }},
  kampagne: {{ kampagne.sessions | tojson }},
  kampagne_slug: "{{ kampagne_slug }}"
};
</script>
<!-- util.js must remain first — app.js + commit.js depend on window.dsaShowIndicator -->
<script src="/static/util.js"></script>
<script src="/static/app.js"></script>
<script src="/static/session.js"></script>
<script src="/static/dice.js"></script>
<script src="/static/tabs.js"></script>
<script src="/static/steigern.js"></script>
<script src="/static/inventar.js"></script>
<script src="/static/zauberspeicher.js"></script>
<script src="/static/journal.js"></script>
<script src="/static/chronik.js"></script>
<script src="/static/commit.js"></script>
</body>
</html>

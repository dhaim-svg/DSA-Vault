  {% endfor %}
</section>

</div><!-- end tab-profil -->

<div class="tab-content" id="tab-journal">

<div class="sec-head"><h2>📓 Kampagnen-Journal</h2><span class="rule"></span></div>

{% if kampagne.sessions %}
  {% for s in kampagne.sessions %}
  <section class="card journal-session" data-session-nr="{{ s.nr }}">

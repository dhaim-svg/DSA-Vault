<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8" />
<title>{{ held.meta.name }} — Heldenkodex</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cardo:ital,wght@0,400;0,700;1,400&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
/* ============================================================
   NIVESISCHER STAHL & TINTE — Heldenkodex
   Bildschirm: kalter Codex · Print: klassisches DSA 4.1 Charakterblatt
   ============================================================ */

:root{
  --bg-deep: #0e1418;
  --bg-elev: #1a2638;
  --bg-card: #131c28;
  --bg-inset: #0b1116;

  --ink:      #e8dcc3;
  --ink-mute: #9aa6b4;
  --ink-dim:  #5f6b7a;
  --rule:     #2b3a52;
  --rule-soft:rgba(95,195,228,.18);

  --accent-cold:  #5fc3e4;
  --accent-magic: #6a5acd;
  --accent-blood: #a83246;
  --accent-gold:  #d4a84b;
  --accent-aup:   #9ec6a8;

  --paper:     #ece4d0;
  --paper-ink: #1a1208;
  --paper-rule:#8a7758;

  --display:'Cinzel','Cardo',serif;
  --subhead: 'Cardo','Spectral',serif;
  --body:    'Spectral',Georgia,serif;
  --mono:    'JetBrains Mono','Iosevka',ui-monospace,monospace;

  --r-card:2px;
  --pad:   22px;
  --gap:   18px;
}

*{ box-sizing:border-box; }
html,body{ margin:0; padding:0; }
body{
  font-family: var(--body);
  font-size: 15px;
  line-height: 1.5;
  color: var(--ink);
  background:
    radial-gradient(1200px 800px at 20% -10%, rgba(95,195,228,.06), transparent 60%),
    radial-gradient(900px 700px at 110% 30%, rgba(106,90,205,.07), transparent 60%),
    linear-gradient(180deg, #0a1014 0%, var(--bg-deep) 40%, #080d11 100%);
  background-attachment: fixed;
  min-height: 100vh;
}
a{ color:var(--accent-cold); text-decoration:none; }
a:hover{ text-decoration:underline; text-underline-offset:3px; }

body::before{
  content:"";
  position:fixed; inset:0;
  background-image:
    radial-gradient(circle at 17% 22%, rgba(232,220,195,.04) 0 1px, transparent 1.5px),
    radial-gradient(circle at 71% 64%, rgba(232,220,195,.03) 0 1px, transparent 1.5px),
    radial-gradient(circle at 43% 88%, rgba(232,220,195,.035) 0 1px, transparent 1.5px),
    radial-gradient(circle at 90% 12%, rgba(95,195,228,.05) 0 1px, transparent 1.5px);
  background-size: 380px 380px, 530px 530px, 290px 290px, 410px 410px;
  pointer-events:none;
  mix-blend-mode:screen;
  z-index:0;
}

.codex{
  max-width:1200px;
  margin:0 auto;
  padding:36px 28px 120px;
  position:relative;
  z-index:1;
}
.grid{ display:grid; gap:var(--gap); }
.cols-2{ grid-template-columns:2fr 1fr; }
.cols-3{ grid-template-columns:1fr 1fr 1fr; }
@media(max-width:900px){ .cols-2,.cols-3{ grid-template-columns:1fr; } }

/* ---- Card ---- */
.card{
  position:relative;
  background:linear-gradient(180deg,rgba(26,38,56,.85),rgba(19,28,40,.92));
  border:1px solid var(--rule-soft);
  border-radius:var(--r-card);
  padding:var(--pad);
  box-shadow:
    inset 0 1px 0 rgba(232,220,195,.04),
    inset 0 0 0 1px rgba(95,195,228,.04),
    0 0 0 1px rgba(0,0,0,.5),
    0 12px 30px -16px rgba(0,0,0,.7),
    0 0 60px -30px rgba(95,195,228,.25);
}
.card::before{
  content:"";
  position:absolute; inset:6px;
  border:1px solid rgba(95,195,228,.12);
  border-radius:1px;
  pointer-events:none;
}
.card-title{
  font-family:var(--display);
  font-weight:600;
  font-size:13px;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--ink);
  margin:0 0 14px;
  display:flex;
  align-items:center;
  gap:12px;
}
.card-title::before{
  content:"";
  display:inline-block;
  width:8px; height:8px;
  border:1px solid var(--accent-cold);
  transform:rotate(45deg);
  box-shadow:0 0 8px rgba(95,195,228,.6);
}
.card-title .meta{
  margin-left:auto;
  font-family:var(--mono);
  font-weight:400;
  font-size:11px;
  letter-spacing:.12em;
  color:var(--ink-mute);
}

/* ---- Banner ---- */
.banner{
  position:relative;
  padding:38px 36px 30px;
  margin-bottom:var(--gap);
  background:
    linear-gradient(180deg,rgba(11,17,22,.95),rgba(19,28,40,.85)),
    radial-gradient(ellipse 60% 100% at 50% 0%,rgba(95,195,228,.18),transparent 70%);
  border:1px solid var(--rule-soft);
  border-radius:var(--r-card);
  overflow:hidden;
  box-shadow:inset 0 0 0 1px rgba(95,195,228,.06),0 0 80px -40px rgba(95,195,228,.45);
}
.banner::before{
  content:"";
  position:absolute; inset:10px;
  border:1px solid rgba(212,168,75,.18);
  pointer-events:none;
}
.sparkles{ position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.sparkle{
  position:absolute;
  width:2px; height:2px;
  background:var(--ink);
  border-radius:50%;
  box-shadow:0 0 6px var(--accent-cold),0 0 12px rgba(95,195,228,.6);
  animation:twinkle 4.4s ease-in-out infinite;
}
.sparkle.big{ width:3px; height:3px; box-shadow:0 0 10px var(--accent-cold),0 0 22px rgba(95,195,228,.55); }
.sparkle:nth-child(1){top:14%;left:6%;animation-delay:.0s}
.sparkle:nth-child(2){top:24%;left:17%;animation-delay:1.1s}
.sparkle:nth-child(3){top:60%;left:9%;animation-delay:.7s}
.sparkle:nth-child(4){top:78%;left:23%;animation-delay:2.3s}
.sparkle:nth-child(5){top:20%;left:35%;animation-delay:3.0s}
.sparkle:nth-child(6){top:70%;left:41%;animation-delay:1.5s}
.sparkle:nth-child(7){top:12%;left:62%;animation-delay:.4s}
.sparkle:nth-child(8){top:84%;left:70%;animation-delay:2.7s}
.sparkle:nth-child(9){top:30%;left:80%;animation-delay:1.8s}
.sparkle:nth-child(10){top:56%;left:88%;animation-delay:.9s}
.sparkle:nth-child(11){top:8%;left:92%;animation-delay:3.4s}
.sparkle:nth-child(12){top:64%;left:55%;animation-delay:2.1s}
@keyframes twinkle{
  0%,100%{opacity:0;transform:scale(.6)}
  45%{opacity:1;transform:scale(1.2)}
  55%{opacity:1;transform:scale(1.2)}
}
.banner-inner{
  position:relative;
  display:grid;
  grid-template-columns:auto 1fr auto;
  align-items:center;
  gap:28px;
}
.crest{ width:84px; height:84px; position:relative; display:grid; place-items:center; }
.crest svg{ width:100%; height:100%; filter:drop-shadow(0 0 12px rgba(95,195,228,.4)); }
.title-block .eyebrow{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:.35em;
  color:var(--accent-cold);
  text-transform:uppercase;
  margin:0 0 6px;
  text-shadow:0 0 12px rgba(95,195,228,.5);
}
.title-block h1{
  font-family:var(--display);
  font-weight:700;
  font-size:44px;
  line-height:1;
  margin:0;
  letter-spacing:.04em;
  color:var(--ink);
  text-shadow:0 0 24px rgba(95,195,228,.18);
}
.title-block h1 .strand{
  background:linear-gradient(180deg,#e8dcc3 0%,#e8dcc3 35%,#ffffff 38%,#ffffff 50%,#e8dcc3 53%,#e8dcc3 100%);
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.title-block .subline{
  font-family:var(--subhead);
  font-style:italic;
  color:var(--ink-mute);
  font-size:16px;
  margin-top:8px;
  letter-spacing:.02em;
}
.identity-stats{ display:flex; gap:22px; align-items:stretch; }
.istat{ text-align:center; padding:6px 14px; border-left:1px solid var(--rule); min-width:78px; }
.istat:first-child{ border-left:0; }
.istat .num{
  font-family:var(--mono);
  font-weight:700;
  font-size:28px;
  color:var(--accent-gold);
  display:block; line-height:1;
  text-shadow:0 0 12px rgba(212,168,75,.35);
}
.istat .num.cold{ color:var(--accent-cold); text-shadow:0 0 12px rgba(95,195,228,.4); }
.istat .lbl{
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.25em;
  text-transform:uppercase;
  color:var(--ink-mute);
  margin-top:6px;
  display:block;
}
.banner-meta{
  margin-top:24px; padding-top:18px;
  border-top:1px solid var(--rule);
  display:flex; flex-wrap:wrap; gap:14px 28px;
  font-family:var(--subhead);
  font-size:14px;
  color:var(--ink-mute);
}
.banner-meta strong{ color:var(--ink); font-weight:700; font-family:var(--subhead); }
.banner-meta .sep{ color:var(--ink-dim); }

/* ---- Vitals ---- */
.vitals{ display:flex; flex-direction:column; gap:14px; }
.vital{
  display:grid;
  grid-template-columns:60px 1fr 110px;
  align-items:center;
  gap:14px;
}
.vital .lbl{ font-family:var(--display); font-size:13px; letter-spacing:.14em; color:var(--ink); }
.vital .val{ font-family:var(--mono); font-size:13px; text-align:right; color:var(--ink-mute); }
.vital .val b{ color:var(--ink); font-weight:700; font-size:16px; }
.bar{
  position:relative;
  height:18px;
  background:var(--bg-inset);
  border:1px solid var(--rule);
  border-radius:1px;
  overflow:hidden;
  box-shadow:inset 0 1px 3px rgba(0,0,0,.6);
}
.bar .fill{
  position:absolute; inset:0 auto 0 0;
  background:linear-gradient(90deg,var(--c1),var(--c2));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.18),inset 0 -1px 0 rgba(0,0,0,.35),0 0 18px var(--c2);
}
.bar .fill::after{
  content:""; position:absolute; inset:0;
  background:
    radial-gradient(40% 80% at 20% 50%,rgba(255,255,255,.35),transparent 60%),
    radial-gradient(20% 80% at 70% 50%,rgba(255,255,255,.18),transparent 60%);
  mix-blend-mode:overlay;
}
.bar .ticks{
  position:absolute; inset:0;
  background-image:repeating-linear-gradient(90deg,rgba(232,220,195,.07) 0 1px,transparent 1px 10%);
  pointer-events:none;
}
.bar.lep .fill{ --c1:#5a1c2a; --c2:var(--accent-blood); }
.bar.asp .fill{ --c1:#244c70; --c2:var(--accent-cold); }
.bar.aup .fill{ --c1:#3d5e4a; --c2:var(--accent-aup); }
.minor-stats{
  margin-top:18px; padding-top:14px; border-top:1px dashed var(--rule);
  display:grid; grid-template-columns:repeat(4,1fr); gap:10px;
}
.minor{ text-align:center; }
.minor .v{ font-family:var(--mono); font-weight:700; font-size:22px; color:var(--ink); display:block; line-height:1; }
.minor .k{ font-family:var(--mono); font-size:10px; letter-spacing:.2em; color:var(--ink-mute); text-transform:uppercase; margin-top:4px; display:block; }

/* ---- Hex Attributes ---- */
.attr-card{ max-width:760px; margin:0 auto; }
.hex-grid{
  display:grid;
  grid-template-columns:repeat(8,1fr);
  gap:6px;
  padding:2px 0;
}
@media(max-width:700px){ .hex-grid{ grid-template-columns:repeat(4,1fr); } }
.hex{ position:relative; aspect-ratio:1/1.08; display:grid; place-items:center; text-align:center; }
.hex .shape{
  position:absolute; inset:0;
  clip-path:polygon(50% 2%,95% 27%,95% 75%,50% 100%,5% 75%,5% 27%);
  background:radial-gradient(ellipse at 50% 0%,rgba(95,195,228,.22),transparent 60%),
             linear-gradient(180deg,#1f2c40,#0d141d);
}
.hex .shape::after{
  content:""; position:absolute; inset:3px;
  clip-path:polygon(50% 2%,95% 27%,95% 75%,50% 100%,5% 75%,5% 27%);
  background:linear-gradient(180deg,rgba(95,195,228,.35),rgba(95,195,228,.05) 40%,transparent 70%);
  -webkit-mask:linear-gradient(#000,#000) content-box,linear-gradient(#000,#000);
  -webkit-mask-composite:xor; mask-composite:exclude;
  padding:1px;
}
.hex .inner{ position:relative; z-index:1; padding:6px 4px; }
.hex .abbr{
  font-family:var(--display); font-size:9px; letter-spacing:.2em;
  color:var(--accent-cold); text-transform:uppercase; display:block;
  text-shadow:0 0 6px rgba(95,195,228,.45);
}
.hex .v{ font-family:var(--mono); font-weight:700; font-size:18px; color:var(--ink); display:block; line-height:1.1; margin-top:2px; }
.hex .full{ font-family:var(--subhead); font-size:8px; color:var(--ink-dim); display:block; margin-top:0; letter-spacing:.04em; }
.hex .mod{ position:absolute; top:14%; right:8%; font-family:var(--mono); font-size:8px; color:var(--accent-gold); z-index:2; }

/* ---- Zauber ---- */
.spell{
  display:grid;
  grid-template-columns: minmax(200px,1.7fr) 90px 38px 80px minmax(110px,1fr) minmax(240px,2fr);
  gap:10px;
  align-items:start;
  padding:9px 10px;
  border-bottom:1px solid rgba(95,195,228,.06);
}
.spell:last-child{ border-bottom:0; }
.spell:hover{ background:rgba(95,195,228,.04); }
.spell .name{ font-family:var(--subhead); font-size:14px; color:var(--ink); }
.spell .name .nlink{ color:var(--ink); text-decoration:none; border-bottom:1px dotted rgba(95,195,228,.25); }
.spell .name .nlink:hover{ color:var(--accent-cold); border-bottom-color:var(--accent-cold); }
.spell .name .nlink::after{ content:" ↗"; color:var(--accent-cold); font-size:10px; opacity:.6; }
.spell .name .haus{ color:var(--accent-gold); font-family:var(--mono); font-size:12px; margin-left:6px; }
.spell .submeta{
  display:block; font-family:var(--mono); font-size:10px;
  color:var(--ink-mute); letter-spacing:.04em; margin-top:4px; line-height:1.4;
}
.spell .probe{ font-family:var(--mono); font-size:11px; color:var(--ink-dim); letter-spacing:.04em; padding-top:2px; }
.zfw-num{
  display:inline-block; font-family:var(--mono); font-weight:700;
  font-size:13px; color:var(--ink); min-width:22px; text-align:right;
}
.spell .zd { font-family:var(--mono); font-size:11px; color:var(--ink-dim); padding-top:2px; }
.spell .kosten { font-family:var(--mono); font-size:11px; color:var(--ink-mute); padding-top:2px; }
.spell .wirkung-cell { padding-top:2px; }
.spell .wirkung { font-size:11px; color:var(--ink-mute); font-style:italic; line-height:1.4; display:block; }
.mods-details { margin-top:5px; }
.mods-details summary.mods-toggle {
  list-style:none; font-family:var(--mono); font-size:9px;
  color:var(--ink-dim); cursor:pointer; letter-spacing:.04em;
}
.mods-details summary.mods-toggle::-webkit-details-marker { display:none; }
.mods-details summary.mods-toggle::marker { display:none; }
.mods-details[open] summary.mods-toggle { color:var(--accent-cold); }
.mods-details .mods-list { display:block; font-size:10px; color:var(--ink-dim); font-style:italic; margin-top:3px; line-height:1.5; }
.legend-row{
  margin-top:10px; padding-top:10px; border-top:1px dashed var(--rule);
  font-family:var(--mono); font-size:10px; color:var(--ink-mute); letter-spacing:.04em;
  display:flex; flex-wrap:wrap; gap:14px;
}
.legend-row span b{ color:var(--accent-gold); }

/* ---- Zauberspeicher ---- */
.speicher-box { margin-top:12px; padding:8px 10px; background:rgba(95,195,228,.06); border-radius:6px; border:1px solid rgba(95,195,228,.15); }
.speicher-title { font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--ink-mute); margin-bottom:6px; font-family:var(--mono); }
.speicher-slot { display:grid; grid-template-columns:16px 40px 1fr; gap:6px; font-size:12px; padding:2px 0; font-family:var(--subhead); }
.speicher-slot.leer { color:var(--ink-dim); font-style:italic; }
.slot-num { font-family:var(--mono); color:var(--accent-cold); }
.slot-asp { font-family:var(--mono); color:var(--ink-dim); }
.slot-zauber { color:var(--ink); }

/* ---- Vol badge (Stabzauber) ---- */
.vol-badge { font-family:var(--mono); font-size:10px; color:var(--ink-dim); background:rgba(95,195,228,.08); border:1px solid rgba(95,195,228,.15); border-radius:2px; padding:1px 5px; margin-left:6px; }

/* ---- Spontane Modifikationen ---- */
.mod-table { display:grid; grid-template-columns:minmax(0,1fr) 130px 175px 80px; column-gap:12px; }
.mod-row { display:contents; }
.mod-row > span { padding:4px 0; border-bottom:1px solid rgba(255,255,255,.04); font-size:12px; }
.mod-row:last-child > span { border-bottom:0; }
.mod-row.header > span { font-family:var(--mono); font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:var(--ink-mute); padding-bottom:6px; border-bottom:1px solid var(--rule); }
.mod-name { color:var(--ink); font-family:var(--subhead); }
.mod-zfp { font-family:var(--mono); color:var(--accent-gold); text-align:right; font-size:11px; white-space:normal; line-height:1.3; }
.mod-probe { font-family:var(--mono); color:var(--ink-mute); text-align:center; font-size:11px; }
.mod-zd { font-family:var(--mono); color:var(--ink-dim); text-align:right; font-size:11px; }
.mod-row.header .mod-zfp, .mod-row.header .mod-zd { text-align:right; }
.mod-row.header .mod-probe { text-align:center; }
.mod-footer-link { display:block; margin-top:8px; font-family:var(--mono); font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:var(--ink-mute); text-align:right; text-decoration:none; }
.mod-footer-link:hover { color:var(--accent-gold); }

/* ---- Talent List ---- */
.talent-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:18px 28px; }
@media(max-width:700px){ .talent-grid{ grid-template-columns:1fr; } }
.talent-grp h4{
  font-family:var(--display); font-size:11px; letter-spacing:.22em; text-transform:uppercase;
  color:var(--accent-cold); margin:0 0 10px; padding-bottom:6px;
  border-bottom:1px solid var(--rule-soft);
  display:flex; align-items:center; gap:8px;
}
.talent-grp h4 .skt{ margin-left:auto; font-family:var(--mono); font-size:10px; color:var(--ink-mute); letter-spacing:.15em; }
.talent-row{
  display:grid;
  grid-template-columns:1fr auto auto;
  gap:10px;
  align-items:center;
  padding:3px 0;
  font-size:13px;
}
.talent-row .t-name{ color:var(--ink); font-family:var(--subhead); }
.talent-row .t-probe{ font-family:var(--mono); font-size:11px; color:var(--ink-mute); letter-spacing:.03em; font-weight:600; }
.talent-row .t-zfw{ font-family:var(--mono); font-weight:700; color:var(--ink); min-width:28px; text-align:right; }
.talent-row.high .t-zfw{ color:var(--accent-gold); }
.talent-row.high .t-name{ color:#f3e8c8; font-weight:700; }
.talent-row.zero .t-name,.talent-row.zero .t-zfw{ color:var(--ink-dim); }

/* ---- Equipment ---- */
.equip-stat{
  display:grid; grid-template-columns:1fr auto;
  align-items:baseline;
  border-bottom:1px dashed var(--rule);
  padding:6px 0;
}
.equip-stat:last-child{ border-bottom:0; }
.equip-stat .k{ font-family:var(--subhead); color:var(--ink-mute); font-size:13px; }
.equip-stat .v{ font-family:var(--mono); color:var(--ink); font-size:14px; }
.weapon-card{
  background:var(--bg-inset); border:1px solid var(--rule-soft);
  padding:14px; margin-bottom:14px;
}
.weapon-card .w-name{
  font-family:var(--display); font-size:14px; letter-spacing:.12em;
  color:var(--accent-gold); text-transform:uppercase; margin-bottom:8px;
}
.weapon-grid{
  display:grid; grid-template-columns:repeat(6,1fr);
  gap:6px; font-family:var(--mono); font-size:11px;
}
.weapon-grid > div{
  background:rgba(95,195,228,.05); padding:6px 4px; text-align:center;
  border:1px solid var(--rule-soft);
}
.weapon-grid .k{ display:block; font-size:9px; color:var(--ink-mute); letter-spacing:.15em; text-transform:uppercase; margin-bottom:2px; }
.weapon-grid .v{ color:var(--ink); font-weight:700; font-size:13px; }
.inv-list{ list-style:none; padding:0; margin:0; }
.inv-list li{
  padding:5px 0; border-bottom:1px dotted var(--rule);
  display:grid; grid-template-columns:auto 1fr auto; gap:12px;
  font-size:13px; font-family:var(--subhead); color:var(--ink);
}
.inv-list li::before{ content:"◇"; color:var(--accent-cold); font-size:9px; }
.inv-list li .qty{ font-family:var(--mono); color:var(--ink-mute); font-size:12px; }

/* ---- SF List ---- */
.sf-list{ list-style:none; padding:0; margin:0; }
.sf-list li{
  padding:9px 0; display:grid; grid-template-columns:14px 1fr;
  gap:10px; border-bottom:1px dotted var(--rule); font-size:13px; align-items:start;
}
.sf-list li:last-child{ border-bottom:0; }
.sf-list li .ico{ color:var(--accent-magic); text-shadow:0 0 6px rgba(106,90,205,.6); font-family:var(--mono); padding-top:2px; }
.sf-list.general li .ico{ color:var(--accent-gold); text-shadow:0 0 6px rgba(212,168,75,.5); }
.sf-list li .sf-name{
  font-family:var(--subhead); color:var(--ink);
  display:inline-flex; align-items:baseline; gap:6px; flex-wrap:wrap;
}
.sf-list li .sf-name a{
  color:var(--ink); text-decoration:none;
  border-bottom:1px dotted rgba(95,195,228,.25);
}
.sf-list li .sf-name a:hover{ color:var(--accent-cold); border-bottom-color:var(--accent-cold); }
.sf-list li .sf-name a::after{ content:" ↗"; color:var(--accent-cold); font-size:10px; opacity:.6; }
.sf-list li .sf-desc{ display:block; color:var(--ink-mute); font-size:12px; margin-top:3px; font-style:italic; line-height:1.4; }

/* ---- Campaign ---- */
.campaign{
  padding:18px;
  background:linear-gradient(135deg,rgba(106,90,205,.10),rgba(95,195,228,.04));
  border:1px solid rgba(106,90,205,.25);
}
.campaign .c-head{ display:flex; align-items:baseline; gap:12px; margin-bottom:8px; }
.campaign h3{ font-family:var(--display); font-size:22px; margin:0; letter-spacing:.04em; color:var(--ink); }
.status{
  display:inline-flex; align-items:center; gap:6px;
  font-family:var(--mono); font-size:10px; letter-spacing:.2em;
  color:var(--accent-gold); text-transform:uppercase;
}
.status .dot-s{
  width:10px; height:10px; border-radius:50%;
  background:var(--accent-gold); box-shadow:0 0 10px var(--accent-gold);
  animation:pulse 2.4s ease-in-out infinite;
}
@keyframes pulse{ 50%{ opacity:.4; transform:scale(.85); } }
.campaign p{ color:var(--ink-mute); margin:6px 0 0; font-style:italic; }
.c-meta{
  margin-top:14px; display:flex; gap:22px;
  font-family:var(--mono); font-size:11px; color:var(--ink-mute); letter-spacing:.12em;
}
.c-meta b{ color:var(--ink); }

/* ---- Activity Feed ---- */
.feed{ list-style:none; margin:0; padding:0; position:relative; }
.feed::before{
  content:""; position:absolute; top:0; bottom:0; left:6px;
  width:1px; background:var(--rule);
}
.feed li{
  position:relative; padding:8px 0 12px 26px;
  font-size:13px; color:var(--ink-mute); font-family:var(--subhead);
}
.feed li::before{
  content:""; position:absolute; left:2px; top:12px;
  width:9px; height:9px; border-radius:50%;
  background:var(--bg-deep); border:1px solid var(--accent-cold);
  box-shadow:0 0 6px rgba(95,195,228,.5);
}
.feed li .when{ font-family:var(--mono); font-size:10px; color:var(--accent-cold); letter-spacing:.15em; display:block; margin-bottom:2px; }
.feed li .what{ color:var(--ink); }

/* ---- Vor/Nachteile ---- */
.vn-grid{ display:grid; grid-template-columns:1fr 1fr; gap:20px; }
@media(max-width:700px){ .vn-grid{ grid-template-columns:1fr; } }
.vn-grp h4{
  font-family:var(--display); font-size:11px; letter-spacing:.22em; text-transform:uppercase;
  margin:0 0 8px; padding-bottom:6px; border-bottom:1px solid var(--rule-soft);
}
.vn-grp.pos h4{ color:var(--accent-cold); }
.vn-grp.neg h4{ color:var(--accent-blood); }
.vn-grp.bad h4{ color:var(--accent-gold); }
.vn-list{ list-style:none; padding:0; margin:0; }
.vn-list li{
  padding:5px 0; border-bottom:1px dotted var(--rule);
  font-size:13px; font-family:var(--subhead);
  display:grid; grid-template-columns:1fr auto; gap:8px;
}
.vn-list li:last-child{ border-bottom:0; }
.vn-list li b{ color:var(--ink); font-weight:700; }
.vn-list li .stufe{ font-family:var(--mono); font-size:11px; color:var(--accent-gold); }
.vn-list li small{ display:block; color:var(--ink-mute); font-size:11px; font-style:italic; margin-top:2px; }

/* ---- Print Button ---- */
.print-btn{
  position:fixed; bottom:28px; right:28px;
  padding:14px 22px;
  background:linear-gradient(180deg,#1f3a55,#102232);
  color:var(--ink); font-family:var(--display); font-size:12px;
  letter-spacing:.22em; text-transform:uppercase;
  border:1px solid var(--accent-cold); border-radius:1px; cursor:pointer;
  box-shadow:0 0 0 1px rgba(0,0,0,.5),0 8px 20px -8px rgba(0,0,0,.7),0 0 30px -8px rgba(95,195,228,.5);
  transition:transform .15s ease,box-shadow .15s ease; z-index:100;
}
.print-btn:hover{
  transform:translateY(-1px);
  box-shadow:0 0 0 1px rgba(0,0,0,.5),0 12px 28px -8px rgba(0,0,0,.7),0 0 50px -6px rgba(95,195,228,.7);
}
.print-btn::before{ content:"❖  "; color:var(--accent-cold); }

/* ---- Section Header ---- */
.sec-head{ margin:30px 0 14px; display:flex; align-items:baseline; gap:16px; }
.sec-head h2{
  font-family:var(--display); font-weight:600; font-size:14px;
  letter-spacing:.35em; text-transform:uppercase; color:var(--ink-mute); margin:0;
}
.sec-head .rule{ flex:1; height:1px; background:linear-gradient(90deg,var(--rule),transparent); }

/* ---- Story (Vorgeschichte) ---- */
.story{ font-size:14px; line-height:1.65; color:var(--ink); }
.story p{ margin:0 0 12px; }
.story p:first-of-type::first-letter{
  font-family:var(--display); font-size:54px; float:left; line-height:.85;
  margin:4px 10px 0 0; color:var(--accent-cold);
  text-shadow:0 0 16px rgba(95,195,228,.45);
}

/* ---- Visibility ---- */
.print-only{ display:none; }
@media print{
  .print-only{ display:block; }
  .screen-only{ display:none !important; }
}

/* ============================================================
   PRINT — DSA 4.1 Klassisches Charakterblatt
   ============================================================ */
@media print{
  @page{ size:A4; margin:14mm 12mm; }
  body{ background:var(--paper) !important; color:var(--paper-ink); font-family:'Cardo','Spectral',serif; font-size:10pt; line-height:1.35; }
  body::before,.sparkles,.print-btn{ display:none !important; }
  .codex{ max-width:100%; padding:0; }
  .page{ page-break-after:always; }
  .page:last-child{ page-break-after:auto; }
  .card,.banner,.campaign{
    background:transparent !important; border:1px solid var(--paper-rule) !important;
    box-shadow:none !important; padding:10px 12px !important; margin-bottom:8px;
    color:var(--paper-ink) !important; border-radius:0;
  }
  .card::before,.banner::before{ display:none !important; }
  .card-title,.sec-head h2,.talent-grp h4,.vn-grp h4,.crest svg,
  .istat .lbl,.minor .k,.hex .abbr,.talent-row .t-probe,
  .spell .merk,.spell .probe,.feed li .when,.c-meta{
    color:var(--paper-ink) !important; text-shadow:none !important;
  }
  .card-title::before{ border-color:var(--paper-ink); box-shadow:none; }
  .sec-head .rule{ background:linear-gradient(90deg,var(--paper-rule),transparent); }
  .sec-head{ margin:14px 0 6px; }
  .sec-head h2{ font-size:9pt; }
  .banner{
    background:transparent !important; text-align:center;
    border-bottom:2px solid var(--paper-ink) !important;
    border-top:0 !important; border-left:0 !important; border-right:0 !important;
    padding:0 0 8px !important; margin-bottom:12px !important;
  }
  .banner-inner{ grid-template-columns:1fr; gap:4px; }
  .title-block h1{ font-family:'Cinzel',serif; color:var(--paper-ink) !important; font-size:22pt; text-shadow:none !important; }
  .title-block h1 .strand{ background:none; color:var(--paper-ink) !important; -webkit-text-fill-color:var(--paper-ink); }
  .title-block .eyebrow{ color:var(--paper-ink) !important; text-shadow:none !important; }
  .title-block .subline{ color:#4a3a20; }
  .crest{ display:none; }
  .identity-stats{ justify-content:center; }
  .istat{ border-color:var(--paper-rule); }
  .istat .num{ color:var(--paper-ink) !important; text-shadow:none !important; font-size:16pt; }
  .banner-meta{ justify-content:center; border-color:var(--paper-ink); color:var(--paper-ink) !important; font-size:9pt; }
  .banner-meta strong{ color:var(--paper-ink) !important; }
  .bar{ background:transparent !important; border:0 !important; border-bottom:1px solid var(--paper-ink) !important; height:12pt !important; box-shadow:none !important; }
  .bar .fill,.bar .ticks{ display:none !important; }
  .vital .lbl,.vital .val,.vital .val b{ color:var(--paper-ink) !important; }
  .vital .val{ font-size:10pt; }
  .minor .v,.minor .k,.hex .v,.hex .full,.hex .mod{ color:var(--paper-ink) !important; text-shadow:none !important; }
  .hex .shape{ clip-path:none !important; background:transparent !important; border:1.5px solid var(--paper-ink); }
  .hex .shape::after{ display:none !important; }
  .hex .abbr{ color:var(--paper-ink) !important; }
  /* --- Eigenschaften: flache 8-Boxen-Zeile --- */
  .attr-card{ max-width:100%; margin:4pt 0 !important; padding:4pt 8pt !important; }
  .hex-grid{ gap:4pt; }
  .hex{ aspect-ratio:auto; padding:4pt 2pt; }
  .hex .shape{ background:transparent !important; }
  .hex .inner{ padding:2pt 0; }
  .hex .abbr{ font-size:8pt !important; margin-bottom:1pt; }
  .hex .v{ font-size:14pt !important; line-height:1; margin-top:0; }
  .hex .full{ display:none; }
  .hex .mod{ position:static; display:inline; font-size:7pt; margin-left:2pt; vertical-align:super; }
  /* --- Talente: 2-spaltig via Multi-Column --- */
  .talent-grid{ display:block !important; column-count:2; column-gap:14pt; }
  .talent-grp{ break-inside:avoid; display:block !important; margin:0 0 8pt; }
  .talent-grp h4{ break-after:avoid; margin-bottom:4pt !important; padding-bottom:3pt !important; font-size:9pt !important; }
  .talent-row{ break-inside:avoid; padding:1pt 0 !important; font-size:10pt !important; }
  .talent-row .t-name,.talent-row .t-zfw{ font-size:10pt !important; }
  .talent-row .t-probe{ font-size:8pt !important; }
  /* --- Sonderfertigkeiten: 2-spaltig --- */
  .sf-list{ column-count:2; column-gap:14pt; }
  .sf-list li{ break-inside:avoid; padding:2pt 0 !important; }
  .sf-list li .sf-desc{ font-size:9pt !important; line-height:1.3; }
  /* --- Page-Break-Hygiene --- */
  .card,.weapon-card,.vn-grp,.speicher-box,.feed li,.istat{ break-inside:avoid; }
  .card-title,.sec-head,.vn-grp h4{ break-after:avoid; }
  .spell{ break-inside:avoid; }
  .story p{ orphans:3; widows:3; }
  .talent-grp h4,.vn-grp h4{ color:var(--paper-ink) !important; border-color:var(--paper-ink) !important; }
  .talent-row,.spell,.vn-list li,.sf-list li,.inv-list li{ border-color:var(--paper-rule) !important; }
  .talent-row .t-name,.talent-row .t-zfw,
  .spell .name,.spell .merk,.spell .probe,
  .vn-list li b,.vn-list li small,
  .sf-list li .sf-name,.sf-list li .sf-desc,
  .inv-list li,.inv-list li .qty{ color:var(--paper-ink) !important; }
  .talent-row.high .t-name,.talent-row.high .t-zfw{ font-weight:700; }
  .talent-row.zero .t-name,.talent-row.zero .t-zfw{ color:#7a6a4a !important; }
  .weapon-card{ background:transparent !important; border-color:var(--paper-ink) !important; }
  .weapon-card .w-name{ color:var(--paper-ink) !important; font-size:10pt; }
  .weapon-grid > div{ background:transparent !important; border-color:var(--paper-ink) !important; }
  .weapon-grid .k,.weapon-grid .v{ color:var(--paper-ink) !important; }
  .sf-list li .ico{ color:var(--paper-ink) !important; text-shadow:none !important; }
  .campaign{ background:transparent !important; border:1px solid var(--paper-ink) !important; }
  .campaign h3,.status,.status .dot-s,.c-meta b,.c-meta{ color:var(--paper-ink) !important; }
  .status .dot-s{ background:var(--paper-ink) !important; box-shadow:none !important; animation:none; }
  .feed::before{ background:var(--paper-rule); }
  .feed li::before{ background:var(--paper) !important; border-color:var(--paper-ink) !important; box-shadow:none; }
  .feed li,.feed li .when,.feed li .what{ color:var(--paper-ink) !important; }
  .vn-grp.pos h4,.vn-grp.neg h4,.vn-grp.bad h4{ color:var(--paper-ink) !important; }
  .vn-list li .stufe{ color:var(--paper-ink) !important; font-weight:700; }
  .story p{ font-size:10pt; line-height:1.5; color:var(--paper-ink); text-indent:0; margin:0 0 8px; }
  .story p + p{ text-indent:14pt; }
  .story p:first-of-type::first-letter{ font-family:'Cinzel',serif; font-size:32pt; float:left; line-height:.9; margin:2pt 6pt 0 0; color:var(--paper-ink); }
}

/* ── Interactive vitals ──────────────────────────────────── */
.vital-stepper {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
  margin-top: 4px;
}
.vital-btn {
  width: 44px;
  height: 44px;
  font-size: 1.4rem;
  line-height: 1;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 6px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  touch-action: manipulation;
  transition: background 0.15s;
}
.vital-btn:active { background: rgba(139,115,85,0.2); }
.vital-input {
  width: 52px;
  font-size: 1.2rem;
  font-weight: 700;
  text-align: center;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 4px;
  background: transparent;
  color: inherit;
  padding: 4px 2px;
  -moz-appearance: textfield;
}
.vital-input::-webkit-inner-spin-button,
.vital-input::-webkit-outer-spin-button { -webkit-appearance: none; }
.vital-sep, .vital-max { opacity: 0.7; font-size: 1rem; }
#save-indicator {
  position: fixed;
  bottom: 16px;
  right: 16px;
  background: rgba(0,0,0,0.75);
  color: #fff;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.85rem;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
  z-index: 9999;
}
#save-indicator.visible { opacity: 1; }
.wunden-counter {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}
.wunden-counter button {
  width: 44px; height: 44px;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 6px;
  background: transparent;
  color: inherit;
  font-size: 1.2rem;
  cursor: pointer;
  touch-action: manipulation;
}
.zustand-chip {
  padding: 4px 10px;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 12px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-size: 0.85rem;
  transition: background 0.15s, color 0.15s;
}
.zustand-chip.active {
  background: var(--accent, #8b7355);
  color: var(--bg, #fdf6e3);
}
@media (max-width: 900px) {
  .vitals-sticky {
    position: sticky;
    top: 0;
    background: var(--bg, #fdf6e3);
    z-index: 100;
    padding: 6px 12px;
    border-bottom: 1px solid var(--accent, #8b7355);
    display: flex;
    gap: 16px;
    font-weight: 700;
    font-size: 0.95rem;
  }
}
@media (min-width: 901px) { .vitals-sticky { display: none; } }
@media print {
  .vital-btn, .vital-input, #save-indicator, .vitals-sticky,
  .wunden-counter, #zustand-chips, #session-reset-btn { display: none !important; }
  .vital-max { font-weight: 700; }
  .vital-stepper { display: none !important; }
  /* Show static value in print */
  .vital::after { content: attr(data-current) " / " attr(data-max); font-weight: 700; }
}
/* ── Dice Panel ────────────────────────────────────────── */
.dice-panel {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--card-bg, #f5ebd8);
  border-top: 2px solid var(--accent, #8b7355);
  padding: 12px 16px 14px;
  z-index: 200;
  box-shadow: 0 -4px 20px rgba(0,0,0,.18);
  font-family: var(--body, serif);
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: transform 0.2s ease;
}
.dice-panel.hidden { transform: translateY(100%); pointer-events: none; }
.dice-panel-header {
  display: flex;
  align-items: center;
  gap: 8px;
}
#dp-title {
  flex: 1;
  font-family: var(--display, serif);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: .04em;
}
.dp-mode-btns { display: flex; gap: 4px; }
.dp-btn {
  padding: 6px 12px;
  min-width: 44px; min-height: 44px;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 6px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-size: 0.9rem;
  touch-action: manipulation;
  transition: background 0.12s;
}
.dp-btn.active, .dp-btn.primary {
  background: var(--accent, #8b7355);
  color: var(--bg, #fdf6e3);
}
.dp-btn:active { opacity: 0.75; }
.dp-eig-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 0.9rem;
  opacity: 0.85;
}
.dp-eig-slot { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.dp-eig-slot .dp-eig-abbr { font-size: 0.75rem; opacity: 0.7; }
.dp-eig-slot .dp-eig-val { font-weight: 700; }
.dp-dice-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}
.dp-die {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.dp-die input[type=number] {
  width: 52px; height: 48px;
  text-align: center;
  font-size: 1.3rem;
  font-weight: 700;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 6px;
  background: transparent;
  color: inherit;
  -moz-appearance: textfield;
}
.dp-die input[type=number]::-webkit-inner-spin-button,
.dp-die input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }
.dp-die-label { font-size: 0.7rem; opacity: 0.65; }
.dp-die-fehl { font-size: 0.8rem; color: var(--accent-blood, #8b1c2a); font-weight: 700; }
.dp-result {
  font-size: 1.1rem;
  font-weight: 700;
  padding: 6px 10px;
  border-radius: 6px;
  min-height: 2.2rem;
}
.dp-result.success { background: rgba(40,140,60,.15); color: #1a6b2a; }
.dp-result.fail    { background: rgba(180,30,30,.12); color: #8b1c2a; }
.dp-result.crit    { background: rgba(80,180,255,.15); color: #1a4a7a; }
.dp-result.patzer  { background: rgba(180,120,30,.15); color: #6b4010; }
.dp-controls {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.dp-controls label { font-size: 0.9rem; display: flex; align-items: center; gap: 6px; }
.dp-controls input[type=number] {
  width: 56px;
  padding: 4px;
  text-align: center;
  border: 1.5px solid var(--accent, #8b7355);
  border-radius: 4px;
  background: transparent;
  color: inherit;
  font-size: 1rem;
  -moz-appearance: textfield;
}
.dp-controls input[type=number]::-webkit-inner-spin-button,
.dp-controls input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }
.dp-action { display: flex; gap: 8px; flex-wrap: wrap; }
/* Clickable rows */
.talent-row[data-probe], .spell[data-probe], .hex[data-eigenschaft],
.minor[data-at], .minor[data-pa], [data-tp] {
  cursor: pointer;
  transition: background 0.1s;
}
.talent-row[data-probe]:hover, .spell[data-probe]:hover,
.hex[data-eigenschaft]:hover, .minor[data-at]:hover, .minor[data-pa]:hover,
[data-tp]:hover { background: rgba(139,115,85,.1); border-radius: 4px; }
@media print { .dice-panel { display: none !important; } }

/* ─── Tab Navigation ─────────────────────────────────────────── */
.tab-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  display: flex;
  gap: 2px;
  background: var(--bg-deep);
  border-bottom: 1px solid var(--rule);
  padding: 6px 14px 0;
  overflow-x: auto;
}
.tab-bar::-webkit-scrollbar { display: none; }
.tab-btn {
  padding: 8px 16px;
  border: 1px solid transparent;
  border-bottom: none;
  border-radius: 6px 6px 0 0;
  background: transparent;
  color: var(--ink-mute);
  font-family: var(--display);
  font-size: 11px;
  letter-spacing: .1em;
  cursor: pointer;
  white-space: nowrap;
  transition: color .15s, background .15s;
}
.tab-btn:hover { color: var(--ink); background: rgba(95,195,228,.07); }
.tab-btn--active {
  color: var(--accent-cold);
  background: var(--bg-elev);
  border-color: var(--rule);
}
.tab-content { display: none; }
.tab-content--active { display: block; }
body { padding-top: 46px; }
@media print {
  .tab-bar { display: none !important; }
  .tab-content { display: block !important; }
  body { padding-top: 0 !important; }
  .inv-stepper, .inv-add-form { display: none !important; }
}
/* Steigern Tab */
.sg-section-head { font-family: var(--display); font-size: 11px; letter-spacing: .18em;
  text-transform: uppercase; color: var(--accent-cold); margin: 20px 0 8px; }
.sg-row { display: flex; align-items: center; gap: 10px; padding: 5px 0;
  border-bottom: 1px solid var(--rule-soft); font-size: 13px; }
.sg-row:last-child { border-bottom: none; }
.sg-name { flex: 1; color: var(--ink); }
.sg-val { color: var(--ink-mute); font-family: var(--mono); font-size: 12px; min-width: 60px; }
.sg-cost { font-family: var(--mono); font-size: 12px; min-width: 52px; font-weight: bold; }
.sg-cost.affordable { color: var(--accent-aup); }
.sg-cost.expensive { color: var(--ink-dim); }
.sg-btn-area { display: flex; align-items: center; gap: 6px; }
.sg-btn { padding: 4px 10px; border: 1px solid var(--rule); border-radius: 4px;
  background: var(--bg-inset); color: var(--ink); cursor: pointer; font-size: 12px; }
.sg-btn:hover { background: var(--bg-elev); }
.sg-btn.disabled { opacity: .4; cursor: default; }
.sg-btn--ok { background: rgba(40,120,60,.3); color: #7fe8a0; border-color: #4a8a60; }
.sg-confirm { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-mute); }
.sg-confirm.hidden, .sg-btn.hidden { display: none; }
.sg-error { font-size: 11px; color: var(--accent-blood); margin-left: 8px; }
.sg-ap-row { display: flex; gap: 20px; flex-wrap: wrap; align-items: baseline; margin-bottom: 8px; }
.sg-ap-label { font-size: 11px; color: var(--ink-mute); text-transform: uppercase; letter-spacing: .1em; }
.sg-ap-val { font-family: var(--mono); font-size: 18px; font-weight: bold; color: var(--ink); margin-left: 4px; }
.sg-ap-val.avail { color: var(--accent-gold); }
.sg-stufe { font-size: 12px; color: var(--ink-mute); }
/* Inventar Tab */
.inv-coin-grid { display: grid; grid-template-columns: 1fr auto auto; gap: 6px 10px; align-items: center; margin-bottom: 14px; }
.inv-coin-label { font-family: var(--subhead); color: var(--ink-mute); font-size: 13px; }
.inv-coin-val { font-family: var(--mono); color: var(--accent-gold); font-size: 18px; font-weight: bold; text-align: right; min-width: 52px; }
.inv-stepper { display: flex; gap: 4px; align-items: center; }
.inv-stepper-btn { width: 26px; height: 26px; border: 1px solid var(--rule); border-radius: 4px; background: var(--bg-inset); color: var(--ink); font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1; font-family: var(--mono); }
.inv-stepper-btn:hover { background: var(--bg-elev); }
.inv-coin-total { font-family: var(--mono); font-size: 11px; color: var(--ink-dim); border-top: 1px solid var(--rule-soft); padding-top: 8px; margin-top: 2px; text-align: right; }
.inv-weight-note { font-family: var(--mono); font-size: 10px; color: var(--ink-dim); margin-top: 8px; letter-spacing: .05em; }
.inv-add-form { display: flex; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule-soft); }
.inv-add-input { flex: 1; background: var(--bg-inset); border: 1px solid var(--rule); border-radius: 4px; color: var(--ink); font-size: 13px; padding: 5px 10px; font-family: var(--subhead); }
.inv-add-btn { padding: 5px 12px; border: 1px solid var(--rule); border-radius: 4px; background: var(--bg-inset); color: var(--ink); cursor: pointer; font-size: 12px; white-space: nowrap; font-family: var(--display); letter-spacing: .05em; }
.inv-add-btn:hover { background: var(--bg-elev); }
.inv-reise-note { font-family: var(--mono); font-size: 10px; color: var(--ink-dim); letter-spacing: .05em; margin-bottom: 8px; }
#inventar-list li { grid-template-columns: auto 1fr auto auto; }
</style>
</head>
<body>
<div class="codex">
<nav class="tab-bar" role="tablist" aria-label="Dashboard-Bereiche">
  <button class="tab-btn" data-tab="kampf"    type="button">⚔️ Kampf</button>
  <button class="tab-btn" data-tab="talente"  type="button">🎯 Talente</button>
  <button class="tab-btn" data-tab="zauber"   type="button">✨ Zauber</button>
  <button class="tab-btn" data-tab="steigern" type="button">⭐ Steigern</button>
  <button class="tab-btn" data-tab="inventar" type="button">🎒 Inventar</button>
  <button class="tab-btn" data-tab="profil"   type="button">📋 Profil</button>
</nav>

{% set name_parts = held.meta.name.split(' ') %}
{% set first_name = name_parts[:-1] | join(' ') %}
{% set last_name = name_parts[-1] %}

<!-- ============================================================
     IDENTITY BANNER (Seite 1 im Print)
     ============================================================ -->
<header class="banner">
  <div class="sparkles screen-only">
    <span class="sparkle"></span><span class="sparkle big"></span><span class="sparkle"></span>
    <span class="sparkle"></span><span class="sparkle"></span><span class="sparkle big"></span>
    <span class="sparkle"></span><span class="sparkle"></span><span class="sparkle"></span>
    <span class="sparkle big"></span><span class="sparkle"></span><span class="sparkle"></span>
  </div>

  <div class="banner-inner">
    <div class="crest">
      <svg viewBox="0 0 100 100" fill="none" stroke="#5fc3e4" stroke-width="1.2">
        <polygon points="50,4 92,28 92,72 50,96 8,72 8,28" />
        <polygon points="50,12 84,32 84,68 50,88 16,68 16,32" stroke-opacity=".5" />
        <line x1="50" y1="22" x2="50" y2="78" stroke-width="2"/>
        <circle cx="50" cy="50" r="9" stroke="#d4a84b" />
        <circle cx="50" cy="50" r="3" fill="#d4a84b" stroke="none"/>
        <line x1="50" y1="50" x2="30" y2="30" />
        <line x1="50" y1="50" x2="70" y2="30" />
        <line x1="50" y1="50" x2="30" y2="70" />
        <line x1="50" y1="50" x2="70" y2="70" />
        <line x1="50" y1="50" x2="50" y2="32" stroke="#e8dcc3" stroke-opacity=".6"/>
        <line x1="50" y1="50" x2="50" y2="68" stroke="#e8dcc3" stroke-opacity=".6"/>
      </svg>
    </div>

    <div class="title-block">
      <p class="eyebrow">{% if held.meta.kolleg %}{{ held.meta.kolleg }}{% else %}{{ held.meta.tradition }}{% endif %} · {{ held.meta.tradition }}</p>
      <h1>{{ first_name }} <span class="strand">{{ last_name }}</span></h1>
      {% if held.meta.wahrer_name %}<div class="subline">„{{ held.meta.wahrer_name }}" — {{ held.meta.wahrer_name_bedeutung }}</div>{% endif %}
    </div>

    <div class="identity-stats">
      <div class="istat">
        <span class="num">{{ held.meta.stufe | roman }}</span>
        <span class="lbl">Stufe</span>
      </div>
      <div class="istat">
        <span class="num">{{ held.meta.ap_gesamt | format_ap }}</span>
        <span class="lbl">AP gesamt</span>
      </div>
      <div class="istat">
        <span class="num cold">{{ held.meta.ap_verfuegbar }}</span>
        <span class="lbl">AP frei</span>
      </div>
    </div>
  </div>

  <div class="banner-meta">
    <span><strong>{{ held.meta.rasse }}</strong></span><span class="sep">·</span>
    <span><strong>{{ held.meta.kultur }}</strong></span><span class="sep">·</span>
    <span><strong>{{ held.meta.profession_short }}</strong></span><span class="sep">·</span>
    <span>Tradition <strong>{{ held.meta.tradition }}</strong></span>
    {% if held.meta.stigma %}<span class="sep">·</span><span>Stigma <strong>{{ held.meta.stigma }}</strong></span>{% endif %}
  </div>
</header>

<div class="tab-content" id="tab-kampf">
<!-- ============================================================
     VITALS + KAMPFWERTE
     ============================================================ -->
{% set le = held.basiswerte.get('LE', {}) %}
{% set ae = held.basiswerte.get('AE', {}) %}
{% set au = held.basiswerte.get('AU', {}) %}
{% set mr = held.basiswerte.get('MR', {}) %}
{% set ini = held.basiswerte.get('INI', {}) %}
{% set at_bw = held.basiswerte.get('AT', {}) %}
{% set pa_bw = held.basiswerte.get('PA', {}) %}
{% set gs = held.eigenschaften.get('GS', {}) %}
{% set so = held.eigenschaften.get('SO', {}) %}

<div class="grid cols-2">
  <section class="card">
    <h3 class="card-title">Vitalia <span class="meta">Aktuell / Maximum</span></h3>
    <div class="vitals">
      <div class="vital">
        <span class="lbl">LeP</span>
        <div class="bar lep"><span class="fill" id="bar-lep" style="width:{{ (le.current / le.max * 100) | round | int if le.max else 100 }}%"></span><span class="ticks"></span></div>
        <div class="vital-stepper"
             data-locator='{"kind":"table_cell","file":"_illaen.md","section_path":["Eigenschaften &amp; Basiswerte","Basiswerte"],"row_key":{"column":"Basiswert","match":"Lebensenergie (LE)"},"column":"Akt.","slug":"{{ slug }}"}'
             data-max="{{ le.max }}"
             data-bar-id="bar-lep">
          <button class="vital-btn vital-btn--minus" aria-label="LeP verringern" type="button">−</button>
          <input class="vital-input" type="number" value="{{ le.current }}" min="0" max="{{ le.max }}" aria-label="Aktuelle Lebensenergie">
          <span class="vital-sep">/</span>
          <span class="vital-max">{{ le.max }}</span>
          <button class="vital-btn vital-btn--plus" aria-label="LeP erhöhen" type="button">+</button>
        </div>
      </div>
      <div class="vital">
        <span class="lbl">AsP</span>
        <div class="bar asp"><span class="fill" id="bar-asp" style="width:{{ (ae.current / ae.max * 100) | round | int if ae.max else 100 }}%"></span><span class="ticks"></span></div>
        <div class="vital-stepper"
             data-locator='{"kind":"table_cell","file":"_illaen.md","section_path":["Eigenschaften &amp; Basiswerte","Basiswerte"],"row_key":{"column":"Basiswert","match":"Astralenergie (AE)"},"column":"Akt.","slug":"{{ slug }}"}'
             data-max="{{ ae.max }}"
             data-bar-id="bar-asp">
          <button class="vital-btn vital-btn--minus" aria-label="AsP verringern" type="button">−</button>
          <input class="vital-input" type="number" value="{{ ae.current }}" min="0" max="{{ ae.max }}" aria-label="Aktuelle Astralenergie">
          <span class="vital-sep">/</span>
          <span class="vital-max">{{ ae.max }}</span>
          <button class="vital-btn vital-btn--plus" aria-label="AsP erhöhen" type="button">+</button>
        </div>
      </div>
      <div class="vital">
        <span class="lbl">AuP</span>
        <div class="bar aup"><span class="fill" id="bar-aup" style="width:{{ (au.current / au.max * 100) | round | int if au.max else 100 }}%"></span><span class="ticks"></span></div>
        <div class="vital-stepper"
             data-locator='{"kind":"table_cell","file":"_illaen.md","section_path":["Eigenschaften &amp; Basiswerte","Basiswerte"],"row_key":{"column":"Basiswert","match":"Ausdauer (AU)"},"column":"Akt.","slug":"{{ slug }}"}'
             data-max="{{ au.max }}"
             data-bar-id="bar-aup">
          <button class="vital-btn vital-btn--minus" aria-label="AuP verringern" type="button">−</button>
          <input class="vital-input" type="number" value="{{ au.current }}" min="0" max="{{ au.max }}" aria-label="Aktuelle Ausdauer">
          <span class="vital-sep">/</span>
          <span class="vital-max">{{ au.max }}</span>
          <button class="vital-btn vital-btn--plus" aria-label="AuP erhöhen" type="button">+</button>
        </div>
      </div>
    </div>
    <div data-wunden="{{ held.meta.wunden }}"></div>
    <div id="zustand-chips" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;margin-bottom:4px"></div>
    <div class="minor-stats">
      <div class="minor"><span class="v">{{ mr.aktuell }}</span><span class="k">MR</span></div>
      <div class="minor"><span class="v">{{ ini.aktuell }}</span><span class="k">INI</span></div>
      <div class="minor"><span class="v">{{ gs.aktuell }}</span><span class="k">GS</span></div>
      <div class="minor"><span class="v">{{ so.aktuell }}</span><span class="k">SO</span></div>
    </div>
  </section>

  <section class="card">
    <h3 class="card-title">Kampfwerte <span class="meta">Basis</span></h3>
    <div class="minor-stats" style="margin-top:0;border-top:0;padding-top:0;grid-template-columns:repeat(3,1fr);gap:14px">
      <div class="minor" data-at="{{ at_bw.aktuell }}"><span class="v" style="color:var(--accent-gold)">{{ at_bw.aktuell }}</span><span class="k">AT-Basis</span></div>
      <div class="minor" data-pa="{{ pa_bw.aktuell }}"><span class="v" style="color:var(--accent-gold)">{{ pa_bw.aktuell }}</span><span class="k">PA-Basis</span></div>
      <div class="minor"><span class="v" style="color:var(--accent-gold)">{{ held.basiswerte.get('FK', {}).aktuell }}</span><span class="k">FK-Basis</span></div>
    </div>
    {% if held.ausruestung.waffen %}
    <div style="margin-top:18px;padding-top:14px;border-top:1px dashed var(--rule)">
      {% set w = held.ausruestung.waffen[0] %}
      <div class="weapon-card">
        <div class="w-name">{{ w.name }}</div>
        <div class="weapon-grid">
          <div><span class="k">DK</span><span class="v">{{ w.dk }}</span></div>
          <div data-tp="{{ w.tp }}"><span class="k">TP</span><span class="v">{{ w.tp }}</span></div>
          <div><span class="k">AT</span><span class="v">{{ w.at }}</span></div>
          <div><span class="k">PA</span><span class="v">{{ w.pa if w.pa else '—' }}</span></div>
          <div><span class="k">INI</span><span class="v">{{ w.ini if w.ini else '+0' }}</span></div>
          <div><span class="k">BF</span><span class="v">{{ w.bf if w.bf else '—' }}</span></div>
        </div>
      </div>
      {% set kampf = held.talente.get('Kampftechniken', []) %}
      {% for kt in kampf %}{% if kt.name in w.name or w.name in kt.name or 'Stab' in kt.name and 'Stab' in w.name %}
      <div style="font-family:var(--mono);font-size:10px;color:var(--ink-mute);letter-spacing:.06em;line-height:1.5">
        Kampftechnik <b style="color:var(--ink)">{{ kt.name }}</b> · TaW {{ kt.taw }}{% if kt.stk %} · Stk {{ kt.stk }}{% endif %}
      </div>
      {% endif %}{% endfor %}
    </div>
    {% endif %}
  </section>
</div>

<!-- Eigenschaften -->
<div class="sec-head"><h2>Eigenschaften</h2><span class="rule"></span></div>
<section class="card attr-card">
  <div class="hex-grid">
    {% set eig_order = ['MU','KL','IN','CH','FF','GE','KO','KK'] %}
    {% for abbr in eig_order %}
    {% set e = held.eigenschaften.get(abbr, {}) %}
    <div class="hex" data-eigenschaft="{{ abbr }}" data-wert="{{ e.get('aktuell', 0) }}">
      <div class="shape"></div>
      {% if e.get('mod', 0) != 0 %}<span class="mod">{% if e.mod > 0 %}+{% endif %}{{ e.mod }}</span>{% endif %}
      <div class="inner">
        <span class="abbr">{{ abbr }}</span>
        <span class="v">{{ e.get('aktuell', '?') }}</span>
        <span class="full">{{ e.get('full', abbr) }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

</div><!-- end tab-kampf -->
<div class="tab-content" id="tab-talente">

<!-- ============================================================
     SEITE 2 — TALENTE
     ============================================================ -->
<div class="sec-head"><h2>Talente</h2><span class="rule"></span></div>
<section class="card">
  <div class="talent-grid">

    {% for grp_name, grp_rows in held.talente.items() %}
    {% set is_kampf = 'Kampftechnik' in grp_name %}
    <div class="talent-grp">
      <h4>
        {{ grp_name | replace(' (SKT D)', '') | replace(' (SKT B)', '') | replace(' (SKT A)', '') }}
        <span class="skt">
          {%- if is_kampf %}AT / PA · TaW
          {%- elif 'SKT D' in grp_name %}SKT D
          {%- elif 'SKT B' in grp_name %}SKT B
          {%- elif 'SKT A' in grp_name %}SKT A
          {%- endif -%}
        </span>
      </h4>
      {% for row in grp_rows %}
      {% set cls = 'high' if row.taw >= 5 else ('zero' if row.taw == 0 else '') %}
      <div class="talent-row {{ cls }}"{% if not is_kampf and '/' in (row.probe or '') %} data-probe="{{ row.probe }}" data-taw="{{ row.taw }}" data-name="{{ row.name }}"{% endif %}>
        <span class="t-name">{{ row.name }}</span>
        <span class="t-probe">
          {%- if is_kampf %}{{ row.at }} / {% if row.pa is not none %}{{ row.pa }}{% else %}—{% endif %}
          {%- else %}{{ row.probe }}
          {%- endif -%}
        </span>
        <span class="t-zfw">{{ row.taw }}</span>
      </div>
      {% endfor %}
    </div>
    {% endfor %}

  </div>
</section>

</div><!-- end tab-talente -->
<div class="tab-content" id="tab-zauber">
<!-- ============================================================
     SEITE 3 — ZAUBER + RITUALE + SONDERFERTIGKEITEN
     ============================================================ -->
<div class="sec-head"><h2>Zauberliste <span style="color:var(--ink-dim);font-size:10px;letter-spacing:.2em">· Repräsentation Mag · × = Hauszauber</span></h2><span class="rule"></span></div>
<section class="card">

  <div class="spell" style="border-bottom:1px solid var(--rule);font-family:var(--mono);font-size:10px;letter-spacing:.18em;color:var(--ink-mute);text-transform:uppercase">
    <span>Zauber</span><span>Probe</span><span>ZfW</span><span>ZD</span><span>Kosten</span><span>Wirkung</span>
  </div>

  {% for z in held.zauber %}
  {% set url = z.wiki_path | obsidian if z.wiki_path else '' %}
  {% set mods_raw = (z.mods or '').strip() %}
  {% set mods_list = mods_raw.split(',') | map('trim') | reject('equalto', '') | reject('equalto', '—') | list %}
  <div class="spell"{% if '/' in (z.probe or '') %} data-probe="{{ z.probe }}" data-zfw="{{ z.zfw }}" data-name="{{ z.name }}" data-kosten="{{ z.kosten }}"{% endif %}>
    <span class="name">
      {% if url %}<a class="nlink" href="{{ url }}">{{ z.name }}</a>{% else %}{{ z.name }}{% endif %}
      {% if z.haus %}<span class="haus">×</span>{% endif %}
      {% if z.merkmale or z.komp or z.lern %}
      <span class="submeta">{{ z.merkmale }}{% if z.komp or z.lern %} · {{ z.komp }}/{{ z.lern }}{% endif %}</span>
      {% endif %}
    </span>
    <span class="probe">{{ z.probe }}</span>
    <span class="zfw-num">{{ z.zfw }}</span>
    <span class="zd">{{ z.zd }}</span>
    <span class="kosten">{{ z.kosten }}</span>
    <span class="wirkung-cell">
      {% if z.wirkung %}<span class="wirkung">{{ z.wirkung }}</span>{% endif %}
      {% if mods_list %}
      <details class="mods-details">
        <summary class="mods-toggle">▸ {{ mods_list | length }} {{ 'Modifikation' if mods_list | length == 1 else 'Modifikationen' }}</summary>
        <span class="mods-list">{{ mods_list | join(', ') }}</span>
      </details>
      {% endif %}
    </span>
  </div>
  {% endfor %}

  <div class="legend-row">
    <span><b>Anti</b> Anti-Magie</span>
    <span><b>Einfl</b> Einfluss</span>
    <span><b>Eign</b> Eigenschaften</span>
    <span><b>Elem</b> Elementar</span>
    <span><b>Form</b> Form</span>
    <span><b>Heil</b> Heilung</span>
    <span><b>Hell</b> Hellsicht</span>
    <span><b>Illu</b> Illusion</span>
    <span><b>Krft</b> Kraft</span>
    <span><b>Meta</b> Meta-Magie</span>
    <span><b>Objk</b> Objekt</span>
    <span><b>Scha</b> Schaden</span>
    <span><b>Tele</b> Telekinese</span>
    <span><b>Umwt</b> Umwelt</span>
    <span><b>Vers</b> Verständigung</span>
  </div>
</section>

{% if held.spontane_mods %}
<section class="card" style="margin-top:var(--gap)">
  <h3 class="card-title">Spontane Modifikationen <span class="meta">max. {{ held.mods_max }} gleichzeitig</span></h3>
  <div class="mod-table">
    <div class="mod-row header">
      <span class="mod-name">Modifikation</span>
      <span class="mod-zfp">ZfP*</span>
      <span class="mod-probe">Probe</span>
      <span class="mod-zd">ZD+</span>
    </div>
    {% for m in held.spontane_mods %}
    <div class="mod-row">
      <span class="mod-name">{{ m.name }}</span>
      <span class="mod-zfp">{{ m.zfp }}</span>
      <span class="mod-probe">{{ m.probe }}</span>
      <span class="mod-zd">{{ m.zd }}</span>
    </div>
    {% endfor %}
  </div>
  <a class="mod-footer-link" href="{{ 'wiki/dsa-4.1/magie/zauberregeln' | obsidian }}">Zauberregeln →</a>
</section>
{% endif %}

<div class="grid cols-2" style="margin-top:var(--gap)">
  <!-- Rituale -->
  <section class="card">
    <h3 class="card-title">Stabzauber &amp; Rituale <span class="meta">Ritualkenntnis {{ held.talente.get('Andere Talente', [{}])[0].get('taw', '') }}</span></h3>
    <ul class="sf-list">
      {% for r in held.rituale.stabzauber %}
      <li><span class="ico">❖</span><span><span class="sf-name">{{ r.name }}{% if r.vol %}<span class="vol-badge">{{ r.vol }}</span>{% endif %}</span><span class="sf-desc">{{ r.effekt }}</span></span></li>
      {% endfor %}
      {% for r in held.rituale.andere %}
      <li><span class="ico">❖</span><span><span class="sf-name">{{ r.name }}</span><span class="sf-desc">{{ r.effekt }}</span></span></li>
      {% endfor %}
    </ul>
    {% if held.rituale.zauberspeicher_slots %}
    <div class="speicher-box">
      <div class="speicher-title">Zauberspeicher-Inhalt</div>
      {% for slot in held.rituale.zauberspeicher_slots %}
      <div class="speicher-slot {% if '—' in slot.zauber or slot.zauber == '' %}leer{% endif %}">
        <span class="slot-num">{{ slot.slot }}</span>
        <span class="slot-asp">{{ slot.asp }}</span>
        <span class="slot-zauber">{{ slot.zauber }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <!-- Sonderfertigkeiten -->
  <section class="card">
    <h3 class="card-title">Sonderfertigkeiten</h3>
    {% if held.sf.magisch %}
    <h4 style="font-family:var(--display);font-size:10px;letter-spacing:.22em;color:var(--accent-magic);margin:0 0 8px;text-transform:uppercase">Magische SF</h4>
    <ul class="sf-list">
      {% for sf in held.sf.magisch %}
      <li><span class="ico">✦</span><span>
        <span class="sf-name">
          {%- if sf.wiki_path -%}
            <a href="{{ sf.wiki_path | obsidian }}">{{ sf.name }}</a>
          {%- else -%}
            {{ sf.name }}
          {%- endif -%}
        </span>
        <span class="sf-desc">{{ sf.desc }}</span>
      </span></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if held.sf.allgemein %}
    <h4 style="font-family:var(--display);font-size:10px;letter-spacing:.22em;color:var(--accent-gold);margin:18px 0 8px;text-transform:uppercase">Allgemeine SF</h4>
    <ul class="sf-list general">
      {% for sf in held.sf.allgemein %}
      <li><span class="ico">◈</span><span>
        <span class="sf-name">
          {%- if sf.wiki_path -%}
            <a href="{{ sf.wiki_path | obsidian }}">{{ sf.name }}</a>
          {%- else -%}
            {{ sf.name }}
          {%- endif -%}
        </span>
        <span class="sf-desc">{{ sf.desc }}</span>
      </span></li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
</div>

</div><!-- end tab-zauber -->

<div class="tab-content" id="tab-steigern">
  <div class="sec-head"><h2>AP &amp; Steigerung</h2><span class="rule"></span></div>
  <section class="card" id="steigern-ap-overview"></section>
  <section class="card" id="steigern-list" style="margin-top:var(--gap)"></section>
</div><!-- end tab-steigern -->

<div class="tab-content" id="tab-inventar">

<!-- Finanzen -->
<div class="sec-head"><h2>Finanzen</h2><span class="rule"></span></div>
<div class="grid cols-2">
  <section class="card">
    <h3 class="card-title">Münzbeutel</h3>
    <div class="inv-coin-grid">
      <span class="inv-coin-label">Dukaten</span>
      <span class="inv-coin-val" id="geld-dukaten">{{ held.ausruestung.geld.dukaten }}</span>
      <div class="inv-stepper">
        <button class="inv-stepper-btn" data-coin="dukaten" data-delta="-1" type="button" aria-label="Dukaten verringern">−</button>
        <button class="inv-stepper-btn" data-coin="dukaten" data-delta="1"  type="button" aria-label="Dukaten erhöhen">+</button>
      </div>
      <span class="inv-coin-label">Silbertaler</span>
      <span class="inv-coin-val" id="geld-silbertaler">{{ held.ausruestung.geld.silbertaler }}</span>
      <div class="inv-stepper">
        <button class="inv-stepper-btn" data-coin="silbertaler" data-delta="-1" type="button" aria-label="Silbertaler verringern">−</button>
        <button class="inv-stepper-btn" data-coin="silbertaler" data-delta="1"  type="button" aria-label="Silbertaler erhöhen">+</button>
      </div>
      <span class="inv-coin-label">Heller</span>
      <span class="inv-coin-val" id="geld-heller">{{ held.ausruestung.geld.heller }}</span>
      <div class="inv-stepper">
        <button class="inv-stepper-btn" data-coin="heller" data-delta="-1" type="button" aria-label="Heller verringern">−</button>
        <button class="inv-stepper-btn" data-coin="heller" data-delta="1"  type="button" aria-label="Heller erhöhen">+</button>
      </div>
      <span class="inv-coin-label">Kreuzer</span>
      <span class="inv-coin-val" id="geld-kreuzer">{{ held.ausruestung.geld.kreuzer }}</span>
      <div class="inv-stepper">
        <button class="inv-stepper-btn" data-coin="kreuzer" data-delta="-1" type="button" aria-label="Kreuzer verringern">−</button>
        <button class="inv-stepper-btn" data-coin="kreuzer" data-delta="1"  type="button" aria-label="Kreuzer erhöhen">+</button>
      </div>
    </div>
    <div class="inv-coin-total" id="geld-total">Gesamt: {{ held.ausruestung.geld.gesamt_kreuzer }} Kr ({{ held.ausruestung.geld.dukaten }} D · {{ held.ausruestung.geld.silbertaler }} S · {{ held.ausruestung.geld.heller }} H · {{ held.ausruestung.geld.kreuzer }} Kr)</div>
  </section>

  <section class="card">
    <h3 class="card-title">Schulden &amp; Verbindlichkeiten</h3>
    <div class="equip-stat">
      <span class="k">Schulden</span>
      <span class="v">{% for n in held.vor_nachteile.nachteile %}{% if 'Schulden' in n.name %}{{ n.stufe }}{% endif %}{% endfor %}</span>
    </div>
    <p style="font-family:var(--mono);font-size:11px;color:var(--ink-dim);margin-top:12px;line-height:1.6">
      1 Dukaten = 10 Silbertaler = 100 Heller = 1000 Kreuzer
    </p>
  </section>
</div>

<!-- Inventar -->
<div class="sec-head"><h2>Inventar</h2><span class="rule"></span></div>
<section class="card">
  <h3 class="card-title">Gegenstände <span class="meta">Inventar-Abschnitt</span></h3>
  {% if held.ausruestung.inventar %}
  <ul class="inv-list" id="inventar-list">
    {% for item in held.ausruestung.inventar %}
    <li data-item-name="{{ item.name | e }}">
      <span>{{ item.name }}</span>
      <span class="qty">{{ item.anzahl }}</span>
      <div class="inv-stepper">
        <button class="inv-stepper-btn" data-item="{{ item.name | e }}" data-delta="-1" type="button" aria-label="{{ item.name | e }} verringern">−</button>
        <button class="inv-stepper-btn" data-item="{{ item.name | e }}" data-delta="1"  type="button" aria-label="{{ item.name | e }} erhöhen">+</button>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% if held.ausruestung.inventar_gewicht_unzen > 0 %}
  <div class="inv-weight-note">Teilgewicht (nur Inventar-Abschnitt): {{ held.ausruestung.inventar_gewicht_unzen }} Unzen — Reiseausrüstung ohne Gewichtsangabe</div>
  {% endif %}
  {% else %}
  <p style="font-family:var(--mono);font-size:11px;color:var(--ink-dim)">Inventar leer.</p>
  {% endif %}
  <div class="inv-add-form">
    <input class="inv-add-input" id="inv-add-name"  type="text" placeholder="Gegenstand" />
    <input class="inv-add-input" id="inv-add-anzahl" type="text" placeholder="Anzahl" style="max-width:80px" />
    <button class="inv-add-btn" id="inv-add-submit" type="button">+ Hinzufügen</button>
  </div>
</section>

<!-- Reiseausrüstung -->
<div class="sec-head"><h2>Reiseausrüstung</h2><span class="rule"></span></div>
<section class="card">
  <h3 class="card-title">Ausrüstung unterwegs</h3>
  <p class="inv-reise-note">Mengenangaben werden in dieser Version nicht bearbeitet (z.B. "5 Tage", "10 Schritt").</p>
  {% if held.ausruestung.reise %}
  <ul class="inv-list">
    {% for item in held.ausruestung.reise %}
    <li>
      <span>{{ item.name }}</span>
      <span class="qty">{{ item.menge }}</span>
      <span style="font-family:var(--mono);font-size:11px;color:var(--ink-dim)">{{ item.anmerkung[:40] if item.anmerkung else '' }}</span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>

</div><!-- end tab-inventar -->

<div class="tab-content" id="tab-profil">

<!-- Vor- & Nachteile -->
<div class="sec-head"><h2>Vor- &amp; Nachteile · Schlechte Eigenschaften</h2><span class="rule"></span></div>
<section class="card">
  <div class="vn-grid">
    <div class="vn-grp pos">
      <h4>Vorteile</h4>
      <ul class="vn-list">
        {% for v in held.vor_nachteile.vorteile %}
        <li>
          <span><b>{{ v.name }}</b>{% if v.anmerkung %}<small>{{ v.anmerkung }}</small>{% endif %}</span>
          <span class="stufe">{{ v.stufe }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    <div class="vn-grp neg">
      <h4>Nachteile</h4>
      <ul class="vn-list">
        {% for n in held.vor_nachteile.nachteile %}
        <li>
          <span><b>{{ n.name }}</b>{% if n.anmerkung %}<small>{{ n.anmerkung }}</small>{% endif %}</span>
          <span class="stufe">{{ n.stufe }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% if held.vor_nachteile.schlecht %}
    <div class="vn-grp bad" style="grid-column:1/-1">
      <h4>Schlechte Eigenschaften</h4>
      <ul class="vn-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:4px 18px">
        {% for s in held.vor_nachteile.schlecht %}
        <li>
          <span><b>{{ s.name }}</b>{% if s.konsequenz %}<small>{{ s.konsequenz[:60] }}{% if s.konsequenz|length > 60 %}…{% endif %}</small>{% endif %}</span>
          <span class="stufe">{{ s.stufe }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>

<!-- Kampagne + Steigerungs-Log -->
<div class="sec-head"><h2>Kampagne · Steigerung</h2><span class="rule"></span></div>
<div class="grid cols-2">
  <section class="card">
    <h3 class="card-title">Aktive Kampagne</h3>
    <div class="campaign">
      <div class="c-head">
        <h3>{{ kampagne.name }}</h3>
        {% if kampagne.status_icon %}
        <span class="status"><span class="dot-s"></span> {{ kampagne.status_text }}</span>
        {% endif %}
      </div>
      <div class="c-meta">
        <span><b>{{ kampagne.sessions | length }}</b> Sessions</span>
        <span><b>1</b> Held</span>
      </div>
    </div>
    {% if kampagne.sessions %}
    <table style="width:100%;border-collapse:collapse;margin-top:14px;font-size:12px;font-family:var(--subhead)">
      <thead><tr style="border-bottom:1px solid var(--rule)">
        <th style="text-align:left;padding:4px 0;font-family:var(--mono);font-size:9px;letter-spacing:.15em;color:var(--ink-mute)">#</th>
        <th style="text-align:left;padding:4px 8px;font-family:var(--mono);font-size:9px;letter-spacing:.15em;color:var(--ink-mute)">Datum</th>
        <th style="text-align:left;padding:4px 0;font-family:var(--mono);font-size:9px;letter-spacing:.15em;color:var(--ink-mute)">Inhalt</th>
      </tr></thead>
      <tbody>
      {% for s in kampagne.sessions %}
      <tr style="border-bottom:1px dotted var(--rule)">
        <td style="padding:5px 0;color:var(--ink-mute)">{{ s.nr }}</td>
        <td style="padding:5px 8px;font-family:var(--mono);font-size:11px;color:var(--ink-mute)">{{ s.datum }}</td>
        <td style="padding:5px 0;color:var(--ink)">{{ s.inhalt }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p style="font-family:var(--mono);font-size:11px;color:var(--ink-dim);margin-top:12px">Noch keine Sessions gespielt.</p>
    {% endif %}
  </section>

  <section class="card">
    <h3 class="card-title">Steigerungs-Log <span class="meta">AP-Chronik</span></h3>
    <ul class="feed">
      {% for entry in held.steigerungslog %}
      <li>
        <span class="when">{{ entry.datum }}</span>
        <span class="what">{{ entry.aktion }}</span>
        {% if entry.begruendung %}<small style="font-family:var(--mono);color:var(--ink-dim);font-size:10px;letter-spacing:.05em">{{ entry.begruendung }}</small>{% endif %}
      </li>
      {% endfor %}
      {% if held._ap_bis_naechste_stufe %}
      <li>
        <span class="when">— in Aussicht</span>
        <span class="what">Stufe {{ held.meta.stufe + 1 }} bei {{ (held.meta.ap_gesamt + held._ap_bis_naechste_stufe) | format_ap }} AP gesamt</span>
        <small style="font-family:var(--mono);color:var(--ink-dim);font-size:10px;letter-spacing:.05em">noch {{ held._ap_bis_naechste_stufe }} AP bis Aufstieg</small>
      </li>
      {% endif %}
    </ul>
  </section>
</div>

<!-- Vorgeschichte -->
<div class="sec-head"><h2>Vorgeschichte</h2><span class="rule"></span></div>
<section class="card story">
  {% for para in held.vorgeschichte_paragraphs %}
  <p>{{ para }}</p>
  {% endfor %}
</section>

</div><!-- end tab-profil -->

</div><!-- .codex -->

<button class="print-btn screen-only" onclick="window.print()">Kodex drucken</button>
<button id="session-reset-btn" class="print-btn screen-only" style="margin-left:8px">Session zurücksetzen</button>

<script>
/* Sortierung Zauber-Tabelle: Click auf ZfW-Header */
(function(){
  var spells = document.querySelectorAll('.spell:not(:first-child)');
  var container = spells[0] && spells[0].parentNode;
  var header = document.querySelector('.spell:first-child');
  if (!container || !header) return;
  var asc = false;
  header.style.cursor = 'pointer';
  header.title = 'Nach ZfW sortieren';
  header.addEventListener('click', function(){
    asc = !asc;
    var arr = Array.from(spells);
    arr.sort(function(a, b){
      var za = parseInt(a.querySelector('.zfw-num') && a.querySelector('.zfw-num').textContent) || 0;
      var zb = parseInt(b.querySelector('.zfw-num') && b.querySelector('.zfw-num').textContent) || 0;
      return asc ? za - zb : zb - za;
    });
    arr.forEach(function(el){ container.appendChild(el); });
  });
})();
</script>
<div id="dice-panel" class="dice-panel hidden">
  <div class="dice-panel-header">
    <span id="dp-title">🎲 Probe</span>
    <span class="dp-mode-btns">
      <button id="dp-auto" class="dp-btn active" type="button">Auto</button>
      <button id="dp-manual" class="dp-btn" type="button">Manuell</button>
    </span>
    <button id="dp-close" class="dp-btn" type="button" aria-label="Panel schließen">✕</button>
  </div>
  <div id="dp-eig-row" class="dp-eig-row"></div>
  <div id="dp-dice-row" class="dp-dice-row"></div>
  <div id="dp-result" class="dp-result"></div>
  <div class="dp-controls">
    <label>Erschwernis&thinsp;<input id="dp-mod" type="number" value="0" min="-20" max="20"></label>
    <button id="dp-roll" class="dp-btn primary" type="button">🔁 Neu würfeln</button>
  </div>
  <div id="dp-action" class="dp-action"></div>
</div>
<div id="save-indicator"></div>
<script>
/* DSA character data for dice.js — regenerated on each render */
window.DSA = {
  eig: {
    MU: {{ held.eigenschaften.MU.aktuell }},
    KL: {{ held.eigenschaften.KL.aktuell }},
    IN: {{ held.eigenschaften.IN.aktuell }},
    CH: {{ held.eigenschaften.CH.aktuell }},
    FF: {{ held.eigenschaften.FF.aktuell }},
    GE: {{ held.eigenschaften.GE.aktuell }},
    KO: {{ held.eigenschaften.KO.aktuell }},
    KK: {{ held.eigenschaften.KK.aktuell }}
  },
  vitals: {
    LE: { current: {{ le.current }}, max: {{ le.max }} },
    AE: { current: {{ ae.current }}, max: {{ ae.max }} },
    AU: { current: {{ au.current }}, max: {{ au.max }} }
  },
  steigern: {
    talente: {{ held.steigerbar_talente | tojson }},
    zauber:  {{ held.steigerbar_zauber  | tojson }},
    ap: {
      verfuegbar:   {{ held.meta.ap_verfuegbar }},
      eingesetzt:   {{ held.meta.ap_eingesetzt }},
      gesamt:       {{ held.meta.ap_gesamt }},
      stufe:        {{ held.meta.stufe }},
      bis_naechste: {{ held.get('_ap_bis_naechste_stufe') | tojson }}
    }
  },
  slug: "{{ slug }}",
  inventar: {
    geld: {{ held.ausruestung.geld | tojson }},
    items: {{ held.ausruestung.inventar | tojson }},
    inventar_gewicht_unzen: {{ held.ausruestung.inventar_gewicht_unzen }}
  }
};
</script>
<script src="/static/app.js"></script>
<script src="/static/session.js"></script>
<script src="/static/dice.js"></script>
<script src="/static/tabs.js"></script>
<script src="/static/steigern.js"></script>
<script src="/static/inventar.js"></script>
</body>
</html>
